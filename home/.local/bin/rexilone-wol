#!/bin/bash
# Wake-on-LAN: включение компьютера «магическим пакетом» по сети (с телефона в Rexlink).
#
#   rexilone-wol status            JSON: интерфейс, MAC, проводной ли, широковещательный адрес, включено ли
#   rexilone-wol enable|disable    включить или выключить (спросит пароль администратора)
#
# Включение — файл /etc/systemd/network/50-rexilone-wol.link (WakeOnLan=magic). Его применяет udev при
# загрузке, так что работает и с NetworkManager, и с systemd-networkd. Сейчас же — через ethtool, если есть.
# Ещё нужно: в BIOS/UEFI включить «Wake on LAN» / «Power On by PCI-E», а для включения из интернета —
# проброс UDP-порта на роутере на этот компьютер.

set -u
LINK=/etc/systemd/network/50-rexilone-wol.link

# интерфейс, через который идёт интернет (иначе — первый проводной)
iface() {
    local d
    d=$(ip -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p')
    if [[ -z "$d" || ! -e /sys/class/net/$d/device ]]; then
        for p in /sys/class/net/*; do
            [[ -e $p/device && ! -e $p/wireless && ! -e $p/phy80211 ]] && { d=${p##*/}; break; }
        done
    fi
    printf '%s' "$d"
}

status() {
    local d mac wired=false brd on=false supported=unknown mode=""
    d=$(iface)
    mac=$(cat "/sys/class/net/$d/address" 2>/dev/null)
    [[ -n "$d" && ! -e /sys/class/net/$d/wireless && ! -e /sys/class/net/$d/phy80211 ]] && wired=true
    brd=$(ip -o -4 addr show dev "$d" 2>/dev/null | sed -n 's/.* brd \([0-9.]*\).*/\1/p' | head -1)
    [[ -f $LINK ]] && grep -qi "^MACAddress=$mac" "$LINK" && on=true
    if command -v ethtool >/dev/null && [[ -n "$d" ]]; then
        local out
        out=$(ethtool "$d" 2>/dev/null)
        if grep -q "Supports Wake-on:" <<<"$out"; then
            grep -q "Supports Wake-on:.*g" <<<"$out" && supported=true || supported=false
            mode=$(sed -n 's/^\s*Wake-on: *//p' <<<"$out" | head -1)
        fi
    fi
    printf '{"iface":"%s","mac":"%s","wired":%s,"broadcast":"%s","enabled":%s,"supported":"%s","mode":"%s","ethtool":%s}\n' \
        "$d" "$mac" "$wired" "${brd:-255.255.255.255}" "$on" "$supported" "$mode" \
        "$(command -v ethtool >/dev/null && echo true || echo false)"
}

# дальше — только от root
as_root() {
    [[ $EUID -eq 0 ]] && return 0
    exec pkexec "$(readlink -f "$0")" "$@"
}

apply_now() {
    local d=$1 m=$2
    if command -v ethtool >/dev/null; then
        ethtool -s "$d" wol "$m" 2>/dev/null
    else
        udevadm trigger --action=add "/sys/class/net/$d" 2>/dev/null
    fi
}

enable() {
    local d mac
    d=$(iface); mac=$(cat "/sys/class/net/$d/address" 2>/dev/null)
    [[ -n "$mac" ]] || { echo "нет сетевого интерфейса" >&2; exit 1; }
    mkdir -p "${LINK%/*}"
    # своя .link заменяет 99-default.link для этой карты: правила имён и MAC — как в ней, чтобы имя не поменялось
    cat > "$LINK" <<EOF
# Rexilone: Wake-on-LAN (Настройки → Электропитание → Включение по сети)
[Match]
MACAddress=$mac

[Link]
NamePolicy=keep kernel database onboard slot path
AlternativeNamesPolicy=database onboard slot path mac
MACAddressPolicy=persistent
WakeOnLan=magic
EOF
    apply_now "$d" g
}

disable() {
    local d
    d=$(iface)
    rm -f "$LINK"
    apply_now "$d" d
}

case "${1:-status}" in
    status) status ;;
    enable) as_root "$@"; enable ;;
    disable) as_root "$@"; disable ;;
    *) echo "использование: rexilone-wol status | enable | disable" >&2; exit 2 ;;
esac
