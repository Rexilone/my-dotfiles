#!/bin/sh
# Проводник RexOS: открыть папку (путь или file:// URI). Без аргумента — домашняя папка.
# Работает, пока запущен шелл (Quickshell); без него — yazi в терминале.
p="${1:-$HOME}"
case "$p" in file://*) p=$(python3 -c 'import sys,urllib.parse as u; print(u.unquote(u.urlparse(sys.argv[1]).path))' "$p") ;; esac
if qs ipc call files open "$p" 2>/dev/null; then
    exit 0
fi
exec foot yazi "$p"
