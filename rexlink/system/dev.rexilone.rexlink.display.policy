<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Rexlink</vendor>
  <action id="dev.rexilone.rexlink.display">
    <description>Use a tablet or phone as an extra monitor</description>
    <description xml:lang="ru">Планшет или телефон как дополнительный монитор</description>
    <message>Rexlink needs to turn on a virtual monitor</message>
    <message xml:lang="ru">Rexlink включает виртуальный монитор</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/rexlink/rexlink-display</annotate>
  </action>
</policyconfig>
