def greeter_conf(t, background):
    """[greeter] для lightdm-gtk-greeter: наш блок, остальное — как было."""
    ours = {
        "background": background or f"#{t['bg']}",
        "user-background": "false",
        "theme-name": "Adwaita-dark" if t["dark"] else "Adwaita",
        "icon-theme-name": "Adwaita",
        "font-name": "JetBrains Mono 11",
        "hide-user-image": "false" if t["greeterUserImage"] else "true",
        "round-user-image": "true",
        "position": "50%,center 50%,center",
        # часы ровно по центру: слева и справа по одному значку одинаковой ширины
        "indicators": "~a11y;~spacer;~clock;~spacer;~power" if t["greeterClock"] else "~a11y;~spacer;~power",
        "clock-format": "%a, %d %b  ·  %H:%M",
        "xft-antialias": "true",
        "xft-hintstyle": "hintslight",
        "screensaver-timeout": "60",
    }
    keep = []
    try:
        for line in open(GREETER_CONF):
            k = line.split("=", 1)[0].strip()
            s = line.strip()
            if s.startswith("# >>> rexilone") or s.startswith("# <<< rexilone") or k in ours:
                continue
            keep.append(line.rstrip("\n"))
    except OSError:
        keep = ["[greeter]"]
    if not any(l.strip() == "[greeter]" for l in keep):
        keep.insert(0, "[greeter]")
    i = next(i for i, l in enumerate(keep) if l.strip() == "[greeter]")
    block = ["# >>> rexilone — оформление в стиле шелла (Настройки → Загрузка и вход)"] + \
            [f"{k}={v}" for k, v in ours.items()] + ["# <<< rexilone"]
    return "\n".join(keep[:i + 1] + block + keep[i + 1:]).rstrip() + "\n"


def apply_greeter(t):
    if not os.path.isdir("/etc/lightdm"):
        return False
    os.makedirs(GREETER_DIR, exist_ok=True)
    os.chmod(STATE, 0o755)
    os.chmod(GREETER_DIR, 0o755)
    background = None
    img = user_jpeg(t, "greeter.jpg" if t["greeterBlur"] else "wallpaper.jpg") or user_jpeg(t, "wallpaper.jpg")
    if img:
        dst = os.path.join(GREETER_DIR, "background.jpg")
        write_file(dst, img, 0o644, binary=True)
        background = dst
    write_file(GREETER_CONF, greeter_conf(t, background), 0o644)
    try:
        lightdm = pwd.getpwnam("lightdm")
        css_dir = os.path.dirname(GREETER_CSS)
        os.makedirs(css_dir, exist_ok=True)
        write_file(GREETER_CSS, greeter_css(t), 0o644)
        for p in (os.path.dirname(css_dir), css_dir, GREETER_CSS):
            os.chown(p, lightdm.pw_uid, lightdm.pw_gid)
    except KeyError:
        log("нет пользователя lightdm — стиль экрана входа не записан")
    log("экран входа оформлен")
    return True


# ── экран входа RexOS (greetd → niri → Quickshell) ─────────────────

NIRI_OUTPUT_KEYS = re.compile(r'^(mode|scale|transform|position|variable-refresh-rate|focus-at-startup|off)( [\w ".@=:-]*)?$')
NIRI_XKB = re.compile(r'^(layout|variant|options|model) "[\w,:()+ -]*"$')


def niri_user_bits():
    """Мониторы и раскладка из настроек niri пользователя — только безопасные строки."""
    home = user_home()
    outputs, xkb, numlock = [], [], False
    for name in ("qs-settings.kdl", "config.kdl"):
        p = os.path.join(home or "/nonexistent", ".config/niri", name)
        try:
            if os.path.islink(p) and not os.path.realpath(p).startswith((home or "/nonexistent") + "/"):
                continue
            text = open(p).read(256 << 10)
        except OSError:
            continue
        path, cur = [], None
        for raw in text.splitlines():
            line = raw.split("//", 1)[0].strip()
            if not line:
                continue
            if line.endswith("{"):
                head = line[:-1].strip()
                path.append(head)
                if len(path) == 1 and re.match(r'^output "[\w .-]+"$', head):
                    cur = [head]
                    outputs.append(cur)
                continue
            if line == "}":
                if path:
                    path.pop()
                if not path:
                    cur = None
                continue
            if cur is not None and len(path) == 1 and NIRI_OUTPUT_KEYS.match(line):
                cur.append(line)
            elif path == ["input", "keyboard", "xkb"] and NIRI_XKB.match(line):
                xkb.append(line)
            elif path == ["input", "keyboard"] and line == "numlock":
                numlock = True
        if outputs or xkb:
            break
    return outputs, xkb, numlock


def greeter_niri():
    outputs, xkb, numlock = niri_user_bits()
    out = ["// сгенерировано rexilone-boot — niri для экрана входа RexOS", "input {", "    keyboard {", "        xkb {"]
    out += [f"            {l}" for l in (xkb or ['layout "us,ru"', 'options "grp:caps_toggle"'])]
    out += ["        }"] + (["        numlock"] if numlock else []) + ["    }", "    touchpad {", "        tap", "    }", "}", ""]
    for o in outputs:
        out += [o[0] + " {"] + [f"    {l}" for l in o[1:]] + ["}", ""]
    out += ["hotkey-overlay {", "    skip-at-startup", "}", "",
            "gestures {", "    hot-corners {", "        off", "    }", "}", "",
            "// Quickshell закрылся (вход выполнен или сбой) — закрыть и niri, дальше решает greetd",
            f'spawn-at-startup "sh" "-c" "qs -p {GREETER_APP}; niri msg action quit --skip-confirmation"', ""]
    return "\n".join(out)


def apply_rexilone_greeter(t):
    os.makedirs(GREETER_DIR, exist_ok=True)
    os.chmod(STATE, 0o755)
    os.chmod(GREETER_DIR, 0o755)
    theme = {
        "colors": {k: "#" + t[k] for k in ("bg", "surface", "surfaceHi", "surfaceHi2", "line", "fg", "muted",
                                          "dim", "faint", "accent", "urgent", "warn")},
        "font": t["font"], "lang": t["lang"], "barStyle": t["barStyle"], "barHeight": t["barHeight"],
        "uiScale": t["uiScale"], "transparency": t["transparency"], "opacity": t["opacity"],
        "primary": t["primary"], "greeterClock": t["greeterClock"], "user": config_user(),
    }
    img = user_jpeg(t, "greeter.jpg" if t["greeterBlur"] else "wallpaper.jpg") or user_jpeg(t, "wallpaper.jpg")
    if img:
        write_file(os.path.join(GREETER_DIR, "background.jpg"), img, 0o644, binary=True)
        theme["background"] = "background.jpg"
    avatar = user_jpeg(t, "avatar.jpg") if t["greeterUserImage"] else None
    if avatar:
        write_file(os.path.join(GREETER_DIR, "avatar.jpg"), avatar, 0o644, binary=True)
        theme["avatar"] = "avatar.jpg"
    write_file(os.path.join(GREETER_DIR, "theme.json"), json.dumps(theme, ensure_ascii=False, indent=1), 0o644)
    write_file(os.path.join(GREETER_DIR, "niri.kdl"), greeter_niri(), 0o644)
    return True


def current_dm():
    try:
        return os.path.basename(os.path.realpath("/etc/systemd/system/display-manager.service")).removesuffix(".service")
    except OSError:
        return ""


def dms_available():
    out = []
    if os.path.exists("/usr/bin/greetd") and os.path.exists(GREETER_BIN) and os.path.isfile(f"{GREETER_APP}/shell.qml"):
        out.append("rexilone")
    if os.path.exists("/usr/bin/lightdm"):
        out.append("lightdm")
    return out


def greetd_conf():
    return ("# сгенерировано rexilone-boot — экран входа RexOS (Настройки → Загрузка и вход)\n"
            "[terminal]\nvt = 1\n\n[default_session]\n"
            f'command = "{GREETER_BIN}"\nuser = "greeter"\n')


def set_dm(which):
    if which not in dms_available():
        log(f"экран входа «{which}» не установлен")
        return False
    if which == "rexilone":
        if os.path.isfile(GREETD_CONF) and not os.path.exists(GREETD_CONF + ".orig"):
            shutil.copy2(GREETD_CONF, GREETD_CONF + ".orig")
        write_file(GREETD_CONF, greetd_conf(), 0o644)
        unit = "greetd.service"
    else:
        unit = "lightdm.service"
    r = run(["systemctl", "enable", "-f", unit])
    if r.returncode != 0:
        log(f"не удалось включить {unit}: {r.stderr.strip()}")
        return False
    run(["systemctl", "set-default", "graphical.target"])
    write_file("/etc/rexilone/dm", which + "\n", 0o644)   # выбор пользователя: install-boot.sh его не меняет
    log(f"экран входа: {which} (со следующей загрузки)")
    return True


