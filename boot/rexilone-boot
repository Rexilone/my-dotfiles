def write_status(extra):
    known = load_json(SYSTEMS, {})
    st = {"time": int(time.time()), "systems": sorted(known.values(), key=lambda s: (s["own"], s["name"].lower())),
          "log": log_lines[-20:], **extra}
    write_file(STATUS, json.dumps(st, ensure_ascii=False, indent=1), 0o644)
    return st


def main():
    if os.geteuid() != 0:
        sys.exit("нужен root (pkexec rexilone-boot …)")
    cmd = sys.argv[1] if len(sys.argv) > 1 else "all"
    if cmd == "status":
        print(json.dumps(load_json(STATUS, {}), ensure_ascii=False))
        return
    if cmd == "dm":
        os.makedirs(STATE, exist_ok=True)
        ok = set_dm(sys.argv[2] if len(sys.argv) > 2 else "")
        st = load_json(STATUS, {})
        st.update(dm=current_dm(), dms=dms_available(), log=log_lines[-20:])
        write_file(STATUS, json.dumps(st, ensure_ascii=False, indent=1), 0o644)
        sys.exit(0 if ok else 1)
    if cmd not in ("scan", "apply", "all", "hide", "show", "forget"):
        print(__doc__)
        return
    os.makedirs(STATE, exist_ok=True)
    os.chmod(STATE, 0o755)
    t = load_theme()
    known = scan() if cmd in ("scan", "all") else load_json(SYSTEMS, {})
    # hide / show — убрать из меню или вернуть (найденная снова система остаётся скрытой);
    # forget — забыть совсем (если диск подключён, при следующем поиске появится снова)
    sid = sys.argv[2] if len(sys.argv) > 2 else ""
    if cmd in ("hide", "show") and sid in known:
        known[sid]["hidden"] = cmd == "hide"
    elif cmd == "forget":
        known.pop(sid, None)
    if cmd in ("hide", "show", "forget"):
        write_file(SYSTEMS, json.dumps(known, ensure_ascii=False, indent=1))
    extra = edit_limine(limine_theme(t, limine_conf()), systems_block(known, t))
    if cmd in ("apply", "all"):
        extra["greeter"] = apply_rexilone_greeter(t)
        apply_greeter(t)                     # LightDM — если стоит (можно вернуться к нему в Настройках)
    else:
        extra["greeter"] = load_json(STATUS, {}).get("greeter", False)
    extra["dm"], extra["dms"] = current_dm(), dms_available()
    extra["themeFound"] = t["found"]
    write_status(extra)


if __name__ == "__main__":
    main()
