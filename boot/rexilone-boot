#!/usr/bin/env python3
"""Загрузка и вход в стиле RexOS (запускается от root).

  rexilone-boot scan           найти системы на всех дисках (Windows, другие Linux…) и добавить их в меню Limine
  rexilone-boot apply          оформить меню Limine и экран входа по теме шелла
  rexilone-boot dm rexilone|lightdm   какой экран входа включить (действует со следующей загрузки)
  rexilone-boot all            scan + apply (при загрузке и выключении — rexilone-boot.service)
  rexilone-boot hide|show <id> убрать систему из меню или вернуть
  rexilone-boot forget <id>    забыть систему (диск отключён навсегда)
  rexilone-boot status         состояние в JSON (то же пишется в /var/lib/rexilone/boot-status.json)

Тему готовит шелл пользователя: ~/.local/state/rexilone/boot/{theme.json, wallpaper.jpg, greeter.jpg, avatar.jpg}.
Экран входа RexOS — greetd → niri → Quickshell (/usr/local/share/rexilone/greeter); его тема и
настройки niri (мониторы, раскладка из ~/.config/niri/qs-settings.kdl) — в /var/lib/rexilone/greeter.
Пользователь — из /etc/rexilone/boot.conf (user=…). Эти файлы — данные, а не код: цвета и числа
проверяются, картинки принимаются только JPEG и не больше 16 МБ.

Меню Limine правится только внутри своих блоков (# >>> rexilone:…), остальное не трогается.
Если в Limine вшит хеш конфига (Secure Boot), конфиг не меняется вовсе.
"""
import glob
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import time

STATE = "/var/lib/rexilone"
SYSTEMS = f"{STATE}/boot-systems.json"
STATUS = f"{STATE}/boot-status.json"
GREETER_DIR = f"{STATE}/greeter"
GREETER_APP = "/usr/local/share/rexilone/greeter"
GREETER_BIN = "/usr/local/lib/rexilone/rexilone-greeter"
GREETD_CONF = "/etc/greetd/config.toml"
CONF = "/etc/rexilone/boot.conf"
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
LIMINE_CANDIDATES = ["/boot/limine.conf", "/boot/limine/limine.conf", "/boot/EFI/limine/limine.conf",
                     "/boot/EFI/BOOT/limine.conf", "/efi/limine.conf", "/efi/EFI/limine/limine.conf",
                     "/efi/EFI/BOOT/limine.conf", "/boot/efi/EFI/limine/limine.conf", "/boot/efi/EFI/BOOT/limine.conf"]
GREETER_CONF = "/etc/lightdm/lightdm-gtk-greeter.conf"
GREETER_CSS = "/var/lib/lightdm/.config/gtk-3.0/gtk.css"
HEX = re.compile(r"^#?[0-9a-fA-F]{6}$")
MANAGED_GLOBALS = {"timeout", "remember_last_entry", "wallpaper", "wallpaper_style", "backdrop",
                   "interface_branding", "interface_branding_colour", "interface_branding_color",
                   "interface_help_hidden", "interface_help_colour", "interface_help_color",
                   "interface_help_colour_bright", "interface_help_color_bright",
                   "term_palette", "term_palette_bright", "term_background", "term_foreground",
                   "term_background_bright", "term_foreground_bright", "term_margin", "term_margin_gradient"}

log_lines = []


def log(msg):
    log_lines.append(msg)
    print(msg, file=sys.stderr)


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=30, **kw)


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_file(path, data, mode=0o644, binary=False):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".rexilone-")
    with os.fdopen(fd, "wb" if binary else "w") as f:
        f.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


# ── пользователь и его тема ──────────────────────────────────────────

def config_user():
    try:
        for line in open(CONF):
            if line.strip().startswith("user="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


def user_home():
    user = ""
    try:
        for line in open(CONF):
            if line.strip().startswith("user="):
                user = line.split("=", 1)[1].strip()
    except OSError:
        pass
    if not user:
        return None
    try:
        return pwd.getpwnam(user).pw_dir
    except KeyError:
        return None


def hexc(v, default):
    v = str(v or "")
    return v.lstrip("#").lower() if HEX.match(v) else default


def num(v, default, lo, hi):
    return max(lo, min(hi, v)) if isinstance(v, (int, float)) and not isinstance(v, bool) else default


def load_theme():
    """theme.json от шелла → проверенные значения."""
    home = user_home()
    src = os.path.join(home, ".local/state/rexilone/boot") if home else None
    raw = load_json(os.path.join(src, "theme.json"), {}) if src else {}
    c = raw.get("colors") if isinstance(raw.get("colors"), dict) else {}
    t = {
        "dir": src,
        "bg": hexc(c.get("bg"), "151515"), "panel": hexc(c.get("panel"), "151515"),
        "surface": hexc(c.get("surface"), "1b1b1b"), "surfaceHi": hexc(c.get("surfaceHi"), "222222"),
        "surfaceHi2": hexc(c.get("surfaceHi2"), "2a2a2a"), "fg": hexc(c.get("fg"), "d4d4d4"),
        "muted": hexc(c.get("muted"), "a0a0a0"), "dim": hexc(c.get("dim"), "6b6b6b"),
        "accent": hexc(c.get("accent"), "d4d4d4"), "urgent": hexc(c.get("urgent"), "c96a6a"),
        "warn": hexc(c.get("warn"), "d7a65f"),
        "dark": bool(raw.get("dark", True)),
        "font": re.sub(r"[^\w .+-]", "", str(raw.get("font") or "JetBrainsMono Nerd Font"))[:60],
        "timeout": raw.get("timeout", 5),
        "remember": bool(raw.get("remember", True)),
        "wallpaper": bool(raw.get("wallpaper", True)),
        "otherSystems": bool(raw.get("otherSystems", True)),
        "greeterBlur": bool(raw.get("greeterBlur", True)),
        "greeterClock": bool(raw.get("greeterClock", True)),
        "greeterUserImage": bool(raw.get("greeterUserImage", False)),
        "line": hexc(c.get("line"), "3a3a3a"), "faint": hexc(c.get("faint"), "333333"),
        "lang": "ru" if raw.get("lang") == "ru" else "en",
        "barStyle": raw.get("barStyle") if raw.get("barStyle") in ("flat", "floating", "pills") else "flat",
        "barHeight": num(raw.get("barHeight"), 32, 24, 56),
        "uiScale": num(raw.get("uiScale"), 1, 0.8, 1.6),
        "transparency": bool(raw.get("transparency", False)),
        "opacity": num(raw.get("opacity"), 0.85, 0.5, 1),
        "primary": re.sub(r"[^\w.-]", "", str(raw.get("primary") or ""))[:40],
        "found": bool(raw),
    }
    to = t["timeout"]
    t["timeout"] = "no" if to == "no" else (str(int(to)) if isinstance(to, (int, float)) and 0 <= to <= 60 else "5")
    return t


def user_jpeg(t, name):
    """Картинка из папки темы, если это правда JPEG разумного размера."""
    if not t["dir"]:
        return None
    p = os.path.join(t["dir"], name)
    try:
        st = os.lstat(p)
        if not os.path.isfile(p) or os.path.islink(p) or st.st_size > 16 << 20 or st.st_size < 1024:
            return None
        with open(p, "rb") as f:
            data = f.read()
        return data if data[:3] == b"\xff\xd8\xff" else None
    except OSError:
        return None


# ── Limine ────────────────────────────────────────────────────────────

def limine_conf():
    for p in LIMINE_CANDIDATES:
        if os.path.isfile(p):
            return p
    return None


def esp_root(conf):
    """Корень раздела EFI, на котором лежит limine.conf (точка монтирования)."""
    d = os.path.dirname(conf)
    while d != "/" and not os.path.ismount(d):
        d = os.path.dirname(d)
    return d


def config_hash_enrolled(conf):
    """Вшит ли хеш конфига в Limine (Secure Boot): тогда менять конфиг нельзя."""
    root = esp_root(conf)
    for exe in glob.glob(os.path.join(root, "EFI", "*", "*.EFI")) + glob.glob(os.path.join(root, "EFI", "*", "*.efi")):
        try:
            data = open(exe, "rb").read()
        except OSError:
            continue
        i = data.find(b"++CONFIG_B2SUM_SIGNATURE++")
        if i < 0:
            continue
        h = data[i + 26:i + 26 + 128]
        if h and set(h) != {ord("0")}:
            return True
    return False


def strip_blocks(lines):
    out, skip = [], False
    for line in lines:
        s = line.strip()
        if s.startswith("# >>> rexilone:"):
            skip = True
            continue
        if s.startswith("# <<< rexilone:"):
            skip = False
            continue
        if not skip:
            out.append(line)
    return out


def edit_limine(theme_block, systems_block):
    conf = limine_conf()
    if not conf:
        log("limine.conf не найден — меню загрузки не меняю")
        return {"limine": False}
    if config_hash_enrolled(conf):
        log("в Limine вшит хеш конфига (Secure Boot) — меню загрузки не меняю")
        return {"limine": True, "path": conf, "locked": True}
    old = open(conf).read()
    lines = strip_blocks(old.splitlines())
    # глобальные параметры, которыми управляем сами, — убрать из «чужой» части (до первого пункта меню)
    first_entry = next((i for i, l in enumerate(lines) if l.strip().startswith("/")), len(lines))
    head, body = [], lines[first_entry:]
    for l in lines[:first_entry]:
        key = l.split(":", 1)[0].strip() if ":" in l else ""
        if key in MANAGED_GLOBALS and theme_block:
            continue
        head.append(l)
    while head and not head[0].strip():
        head.pop(0)
    while body and not body[-1].strip():
        body.pop()
    parts = []
    if theme_block:
        parts += ["# >>> rexilone:theme (generated by rexilone-boot, Settings > Boot & login)", *theme_block,
                  "# <<< rexilone:theme", ""]
    parts += head + body
    if systems_block:
        parts += ["", "# >>> rexilone:systems (systems found on other disks, generated by rexilone-boot)",
                  *systems_block, "# <<< rexilone:systems"]
    new = "\n".join(parts).rstrip() + "\n"
    if new != old:
        orig = conf + ".orig"
        if not os.path.exists(orig):
            shutil.copy2(conf, orig)           # самый первый вариант — на всякий случай
        shutil.copy2(conf, conf + ".bak")
        write_file(conf, new, 0o644)
        log(f"меню загрузки обновлено: {conf}")
    return {"limine": True, "path": conf, "locked": False}


def limine_theme(t, conf):
    """Строки глобальных параметров Limine по теме шелла."""
    if not t["found"]:
        return []
    bg, fg = t["bg"], t["fg"]
    lines = [f"timeout: {t['timeout']}"]
    if t["remember"]:
        lines.append("remember_last_entry: yes")
    lines += [
        "interface_branding: RexOS",
        f"interface_branding_colour: {t['accent']}",
        "interface_help_hidden: yes",
        f"interface_help_colour: {t['dim']}",
        f"interface_help_colour_bright: {t['fg']}",
        f"term_foreground: {fg}",
        f"term_foreground_bright: {fg}",
        f"term_background_bright: {t['surfaceHi2']}",
        # чёрный, красный, зелёный, коричневый, синий, пурпурный, голубой, серый
        f"term_palette: {bg};{t['urgent']};{t['accent']};{t['warn']};{t['accent']};{t['accent']};{t['accent']};{t['muted']}",
        f"term_palette_bright: {t['dim']};{t['urgent']};{fg};{t['warn']};{fg};{fg};{fg};{fg}",
        f"backdrop: {bg}",
    ]
    img = user_jpeg(t, "wallpaper.jpg") if t["wallpaper"] else None
    if img and conf:
        dst = os.path.join(os.path.dirname(conf), "rexilone-wallpaper.jpg")
        try:
            if not os.path.exists(dst) or open(dst, "rb").read() != img:
                write_file(dst, img, 0o644, binary=True)
            rel = "/" + os.path.relpath(dst, esp_root(conf))
            # карточка меню по центру: полупрозрачный фон темы и мягкий край
            lines += ["wallpaper: boot():" + rel, "wallpaper_style: stretched",
                      f"term_background: 30{t['panel']}", "term_margin: 140", "term_margin_gradient: 40"]
        except OSError as e:
            log(f"обои меню загрузки: {e}")
    else:
        lines += [f"term_background: 00{bg}", "term_margin: 0"]
    return lines


# ── поиск систем ──────────────────────────────────────────────────────

KNOWN = [  # (путь внутри ESP, название) — по порядку предпочтения
    ("EFI/Microsoft/Boot/bootmgfw.efi", "Windows"),
]
DISTROS = {"ubuntu": "Ubuntu", "fedora": "Fedora", "debian": "Debian", "opensuse": "openSUSE", "manjaro": "Manjaro",
           "pop": "Pop!_OS", "linuxmint": "Linux Mint", "mint": "Linux Mint", "endeavouros": "EndeavourOS",
           "arch": "Arch Linux", "garuda": "Garuda", "cachyos": "CachyOS", "nixos": "NixOS", "centos": "CentOS",
           "rocky": "Rocky Linux", "almalinux": "AlmaLinux", "kali": "Kali Linux", "elementary": "elementary OS",
           "zorin": "Zorin OS", "neon": "KDE neon", "gentoo": "Gentoo", "void": "Void Linux", "redhat": "Red Hat",
           "steamos": "SteamOS", "systemd": "Linux (systemd-boot)", "refind": "rEFInd", "limine": "Linux (Limine)"}
LOADERS = ["shimx64.efi", "grubx64.efi", "systemd-bootx64.efi", "refind_x64.efi", "BOOTX64.EFI", "limine_x64.efi"]


def lsblk():
    r = run(["lsblk", "-J", "-b", "-o", "PATH,TYPE,PKNAME,PARTUUID,PARTTYPE,FSTYPE,MOUNTPOINTS,MODEL,VENDOR,SIZE,TRAN,RM"])
    try:
        return json.loads(r.stdout).get("blockdevices", [])
    except ValueError:
        return []


def flatten(devs, parent=None):
    for d in devs:
        d["parent"] = parent
        yield d
        yield from flatten(d.get("children") or [], d)


def find_ci(root, rel):
    """Путь без учёта регистра (FAT): EFI/Microsoft/Boot/bootmgfw.efi."""
    cur = root
    for part in rel.split("/"):
        try:
            names = os.listdir(cur)
        except OSError:
            return None
        hit = next((n for n in names if n.lower() == part.lower()), None)
        if not hit:
            return None
        cur = os.path.join(cur, hit)
    return os.path.relpath(cur, root)


def scan_esp(mnt, own):
    """Загрузчики на разделе EFI: [(путь, название)]."""
    found = []
    for rel, name in KNOWN:
        p = find_ci(mnt, rel)
        if p:
            found.append((p, name))
    efi = find_ci(mnt, "EFI") or ""
    try:
        dirs = sorted(os.listdir(os.path.join(mnt, efi))) if efi else []
    except OSError:
        dirs = []
    for d in dirs:
        low = d.lower()
        if low in ("microsoft", "boot", "linux", "tools", "dell", "hp", "lenovo", "asus", "oem") or (own and low == "limine"):
            continue
        for loader in LOADERS:
            p = find_ci(mnt, f"{efi}/{d}/{loader}")
            if p:
                found.append((p, DISTROS.get(low, d)))
                break
    if not own:
        # чужой диск: собственные ядра (UKI) и запасной загрузчик, если ничего не нашли
        for uki in sorted(glob.glob(os.path.join(mnt, efi, "[Ll]inux", "*.efi"))):
            found.append((os.path.relpath(uki, mnt), "Linux · " + os.path.basename(uki)[:-4]))
        if not found:
            p = find_ci(mnt, f"{efi}/BOOT/BOOTX64.EFI")
            if p:
                found.append((p, "Other system"))
    return found


def scan():
    conf = limine_conf()
    own_root = esp_root(conf) if conf else None
    known = load_json(SYSTEMS, {})
    seen = set()
    for d in flatten(lsblk()):
        if d.get("type") != "part" or (d.get("parttype") or "").lower() != ESP_TYPE or not d.get("partuuid"):
            continue
        mounts = [m for m in (d.get("mountpoints") or []) if m]
        own = bool(own_root and own_root in mounts)
        disk = d.get("parent") or {}
        label = " ".join(x for x in ((disk.get("vendor") or "").strip(), (disk.get("model") or "").strip()) if x) or disk.get("path", "")
        tmp = None
        mnt = mounts[0] if mounts else None
        if not mnt:
            tmp = tempfile.mkdtemp(prefix="rexilone-esp-")
            r = run(["mount", "-o", "ro,noexec,nosuid,nodev", d["path"], tmp])
            if r.returncode != 0:
                os.rmdir(tmp)
                continue
            mnt = tmp
        try:
            for rel, name in scan_esp(mnt, own):
                sid = f"{d['partuuid']}:{rel.lower()}"
                seen.add(sid)
                known[sid] = {"id": sid, "name": name, "disk": label, "own": own, "partuuid": d["partuuid"],
                              "path": "/" + rel.replace(os.sep, "/"), "removable": bool(d.get("rm") or disk.get("rm")),
                              "tran": disk.get("tran") or "", "present": True, "lastSeen": int(time.time()),
                              "hidden": known.get(sid, {}).get("hidden", False)}
        finally:
            if tmp:
                run(["umount", tmp])
                os.rmdir(tmp)
    for sid, s in known.items():
        if sid not in seen:
            s["present"] = False
    write_file(SYSTEMS, json.dumps(known, ensure_ascii=False, indent=1))
    log(f"систем найдено: {sum(1 for s in known.values() if s['present'])}, запомнено: {len(known)}")
    return known


def systems_block(known, t):
    if not t["otherSystems"]:
        return []
    out = []
    for s in sorted(known.values(), key=lambda s: (s["own"], s["name"].lower())):
        if s.get("hidden"):
            continue
        res = "boot()" if s["own"] else f"guid({s['partuuid']})"
        title = s["name"] if s["own"] else f"{s['name']} · {s['disk']}"
        title = re.sub(r"[\r\n/\\#]", " ", title).strip()[:80]
        out += [f"/{title}", "    protocol: efi", f"    path: {res}:{s['path']}", ""]
    return out[:-1] if out else []


